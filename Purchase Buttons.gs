/***** PURCHASE CSV BUTTONS — picture buttons on the "Purchase CSV" sheet (top, columns C–E) *****
 * LOOSE PURCHASE → openLoosePurchase | DOWNLOAD XLSX FILE → pcExportXlsx | CLEAR ALL LINES → pcClearRows
 * Same idea as the Print Console buttons: if a button with the same alt title is already there its picture
 * is swapped in the same place and size (so a button you dragged stays where you put it).
 * Run Product Tools → Purchase CSV for POS → Place buttons to put them back / refresh the pictures
 * (also done by Set up / repair sheet). 328x152 pictures (4x), shown at 82x38.
 */

const PB_LOOSE_TITLE_ = 'LOOSE PURCHASE';
const PB_DOWNLOAD_TITLE_ = 'DOWNLOAD XLSX FILE';
const PB_CLEAR_TITLE_ = 'CLEAR ALL LINES';
const PB_LOOSE_PNG_ = '';
const PB_DOWNLOAD_PNG_ = '';
const PB_CLEAR_PNG_ = '';

function pcPlaceButton_(sh, title, png, col, row, offX, offY, fn) {
  let w = 82, h = 38;
  const old = sh.getImages().filter(img => img.getAltTextTitle() === title);
  if (old.length) {
    const o = old[0], a = o.getAnchorCell();
    col = a.getColumn(); row = a.getRow(); offX = o.getAnchorCellXOffset(); offY = o.getAnchorCellYOffset();
    w = o.getWidth(); h = o.getHeight();
    old.forEach(img => img.remove());
  }
  const blob = Utilities.newBlob(Utilities.base64Decode(png), 'image/png', title.toLowerCase().replace(/\s+/g, '-') + '.png');
  const img = sh.insertImage(blob, col, row, offX, offY);
  img.setWidth(w).setHeight(h);
  img.setAltTextTitle(title);
  img.assignScript(fn);
}

// Menu + setup: the three buttons in rows 1-2, over the empty cells C–E.
function pcPlaceButtons(quiet) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(PC_SHEET_);
  if (!sh) { SpreadsheetApp.getUi().alert('Run Set up / repair sheet first.'); return; }
  pcPlaceButton_(sh, PB_LOOSE_TITLE_, PB_LOOSE_PNG_, 3, 1, 4, 3, 'openLoosePurchase');
  pcPlaceButton_(sh, PB_DOWNLOAD_TITLE_, PB_DOWNLOAD_PNG_, 4, 1, 8, 3, 'pcExportXlsx');
  pcPlaceButton_(sh, PB_CLEAR_TITLE_, PB_CLEAR_PNG_, 5, 1, 20, 3, 'pcClearRows');
  if (!quiet) ss.toast('Buttons are on the Purchase CSV sheet. You can drag them anywhere.', 'Buttons', 5);
}
